{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest",
      "type": "shell",
      "command": "uv run pytest tests/",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "coverage",
      "type": "shell",
      "command": "uv run coverage run --parallel -m pytest ; uv run coverage combine ; uv run coverage report",
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "reinstall dependencies",
      "type": "shell",
      "command": "uv sync",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
